msgid "Sizer"
msgstr "Sizer"

msgid "Choose a window size preset at the pointer"
msgstr "Choisir un préréglage de taille de fenêtre au pointeur"

msgid "No presets configured"
msgstr "Aucun préréglage configuré"

msgid "no active window"
msgstr "aucune fenêtre active"

#, c-format
msgid "... %d more"
msgstr "... %d de plus"

msgid "the preset menu has no entries"
msgstr "le menu des préréglages n'a pas d'entrées"

#, c-format
msgid "cannot open X display: %s"
msgstr "impossible d'ouvrir l'affichage X : %s"

#, c-format
msgid "another client holds the pointer (grab status %s after %d attempts); GNOME holds the devices itself, use the shell extension menu there"
msgstr "un autre client détient le pointeur (état de capture %s après %d tentatives) ; GNOME détient les périphériques lui-même, utilisez le menu de l'extension shell là-bas"

#, c-format
msgid "another client holds the keyboard (grab status %s after %d attempts); GNOME keeps the devices grabbed for the whole session, use the shell extension menu there"
msgstr "un autre client détient le clavier (état de capture %s après %d tentatives) ; GNOME garde les périphériques capturés pendant toute la session, utilisez le menu de l'extension shell là-bas"

msgid "the menu window was never mapped"
msgstr "la fenêtre du menu n'a jamais été mappée"

msgid "no controllable windows"
msgstr "aucune fenêtre contrôlable"

