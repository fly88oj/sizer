msgstr "l'extension shell est de retour"

#, c-format
msgid "pushed %d of %d presets from %s"
msgstr "%d sur %d préréglages envoyés depuis %s"

msgid "built-in presets"
msgstr "préréglages intégrés"

#, c-format
msgid "the shell extension rejected the preset list (%s); its menu keeps the previous presets"
msgstr "l'extension shell a rejeté la liste des préréglages (%s) ; son menu garde les préréglages précédents"

#, c-format
msgid "cannot read the SetPresets reply (%s): %s"
msgstr "impossible de lire la réponse SetPresets (%s) : %s"

#, c-format
msgid "SetPresets failed: %s"
msgstr "SetPresets a échoué : %s"

#, c-format
msgid "waiting for the GNOME shell extension (%s): %s"
msgstr "en attente de l'extension shell GNOME (%s) : %s"

#, c-format
msgid "the shell extension skipped %s: %s"
msgstr "l'extension shell a ignoré %s : %s"

msgid "<unnamed>"
msgstr "<sans nom>"

msgid "invalid preset"
msgstr "préréglage invalide"

#, c-format
msgid "options.hotkey: %s; the GNOME extension keeps its current keybinding"
msgstr "options.hotkey : %s ; l'extension GNOME conserve sa liaison de touches actuelle"

#, c-format
msgid "cannot connect to the session bus: %s"
msgstr "impossible de se connecter au bus de session : %s"

#, c-format
msgid "unsupported version %d, expected %d"
msgstr "version non prise en charge %d, attendue %d"

msgid "a separator must not carry a label, size, anchor, position, hotkey or monitor"
msgstr "un séparateur ne doit pas porter d'étiquette, taille, ancre, position, raccourci ou moniteur"

msgid "label must not be empty"
msgstr "l'étiquette ne doit pas être vide"

#, c-format
msgid "duplicate label %s in the same group"
msgstr "étiquette en double %s dans le même groupe"

msgid "hotkey must not be empty"
msgstr "le raccourci ne doit pas être vide"

msgid "x and y must be set together"
msgstr "x et y doivent être définis ensemble"

msgid "anchor and x/y are mutually exclusive"
msgstr "ancre et x/y sont mutuellement exclusifs"

msgid "not an object"
msgstr "pas un objet"

msgid "size must look like 1024x768 or 50%x50%"
msgstr "la taille doit ressembler à 1024x768 ou 50%x50%"

#, c-format
msgid "unknown anchor %s"
msgstr "ancre inconnue %s"

msgid "x and y must be integers set together"
msgstr "x et y doivent être des entiers définis ensemble"

#, c-format
msgid "unknown monitor %s"
msgstr "moniteur inconnu %s"

