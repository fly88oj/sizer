msgstr "raccourci %s indisponible : %s"

#, c-format
msgid "fired %d time(s) in %ds"
msgstr "déclenché %d fois en %ds"

msgid "gnome extension not on the session bus (install it, log out and back in, then `gnome-extensions enable sizer@sizerlinux.dev`)"
msgstr "l'extension GNOME n'est pas sur le bus de session (installez-la, déconnectez-vous et reconnectez-vous, puis `gnome-extensions enable sizer@sizerlinux.dev`)"

#, c-format
msgid "gnome extension running (%d presets, menu %s)"
msgstr "extension GNOME en cours d'exécution (%d préréglages, menu %s)"

