msgstr "surveillance de %s"

#, c-format
msgid "%s disappeared; using built-in presets"
msgstr "%s a disparu ; utilisation des préréglages intégrés"

#, c-format
msgid "configuration changed; pushing new presets"
msgstr "configuration modifiée ; envoi des nouveaux préréglages"

#, c-format
msgid "%s: %s; keeping the last good presets"
msgstr "%s : %s ; conservation des derniers préréglages valides"

