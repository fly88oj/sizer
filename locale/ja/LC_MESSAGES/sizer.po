#, c-format
msgid "window %s maximized = %s"
msgstr "ウィンドウ %s 最大化 = %s"

#. From daemon.rs - daemon messages
#, c-format
msgid "no configuration file at %s; using built-in presets"
msgstr "%s に設定ファイルがありません；ビルトインプリセットを使用します"

#, c-format
msgid "watching %s"
msgstr "%s を監視中"

#, c-format
msgid "%s disappeared; using built-in presets"
msgstr "%s が消失しました；ビルトインプリセットを使用します"

#, c-format
msgid "configuration changed; pushing new presets"
msgstr "設定が変更されました；新しいプリセットをプッシュしています"

#, c-format
msgid "%s: %s; keeping the last good presets"
msgstr "%s：%s；最後の有効なプリセットを保持します"

msgid "shell extension is back"
msgstr "シェル拡張が復旧しました"

#, c-format
msgid "pushed %d of %d presets from %s"
msgstr "%1$d/%2$d 個のプリセットを %3$s からプッシュしました"

msgid "built-in presets"
msgstr "ビルトインプリセット"

#, c-format
msgid "the shell extension rejected the preset list (%s); its menu keeps the previous presets"
msgstr "シェル拡張がプリセットリスト（%s）を拒否しました；そのメニューは前回のプリセットを保持します"

#, c-format
msgid "cannot read the SetPresets reply (%s): %s"
msgstr "SetPresets の応答を読み取れません（%s）：%s"

#, c-format
msgid "SetPresets failed: %s"
msgstr "SetPresets 失敗：%s"

#, c-format
msgid "waiting for the GNOME shell extension (%s): %s"
msgstr "GNOME シェル拡張を待機中（%s）：%s"

#, c-format
msgid "the shell extension skipped %s: %s"
msgstr "シェル拡張が %s をスキップしました：%s"

msgid "<unnamed>"
msgstr "<無名>"

msgid "invalid preset"
msgstr "無効なプリセット"

#. From daemon.rs - hotkey warnings
#, c-format
msgid "options.hotkey: %s; the GNOME extension keeps its current keybinding"
msgstr "options.hotkey：%s；GNOME 拡張は現在のキーバインドを保持します"

#, c-format
msgid "cannot connect to the session bus: %s"
msgstr "セッションバスに接続できません：%s"

#. From config/src/lib.rs - validation messages
#, c-format
msgid "unsupported version %d, expected %d"
msgstr "サポートされていないバージョン %d、期待値は %d"

msgid "a separator must not carry a label, size, anchor, position, hotkey or monitor"
msgstr "セパレータにはラベル、サイズ、アンカー、位置、ホットキー、モニターを設定できません"

msgid "label must not be empty"
msgstr "ラベルは空にできません"

#, c-format
msgid "duplicate label %s in the same group"
msgstr "同じグループに重複したラベル %s があります"

msgid "hotkey must not be empty"
msgstr "ホットキーは空にできません"

msgid "x and y must be set together"
msgstr "x と y は同時に設定する必要があります"

msgid "anchor and x/y are mutually exclusive"
msgstr "anchor と x/y は互いに排他的です"

#. From extension.js - preset problem descriptions
msgid "not an object"
msgstr "オブジェクトではありません"

msgid "size must look like 1024x768 or 50%x50%"
msgstr "サイズは 1024x768 または 50%x50% の形式でなければなりません"

#, c-format
msgid "unknown anchor %s"
msgstr "不明なアンカー %s"

msgid "x and y must be integers set together"
msgstr "x と y は整数で同時に設定する必要があります"

#, c-format
msgid "unknown monitor %s"
msgstr "不明なモニター %s"

