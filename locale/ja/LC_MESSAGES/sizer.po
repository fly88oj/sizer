#. From sizer.desktop
msgid "Sizer"
msgstr "Sizer"

#. From sizer.desktop
msgid "Choose a window size preset at the pointer"
msgstr "ポインタ位置でウィンドウサイズプリセットを選択"

#. From tray/src/lib.rs - tray title
msgid "No presets configured"
msgstr "プリセットが設定されていません"

#. From tray/src/lib.rs - no active window label
msgid "no active window"
msgstr "アクティブなウィンドウなし"

#. From popup/src/lib.rs - overflow submenu label
#, c-format
msgid "... %d more"
msgstr "... 他 %d 件"

#. From popup/src/lib.rs - no preset entries error
msgid "the preset menu has no entries"
msgstr "プリセットメニューにエントリがありません"

#. From popup/src/lib.rs - X display error
#, c-format
msgid "cannot open X display: %s"
msgstr "X ディスプレイを開けません：%s"

#. From popup/src/lib.rs - pointer grab held by another client
#, c-format
msgid "another client holds the pointer (grab status %s after %d attempts); GNOME holds the devices itself, use the shell extension menu there"
msgstr "他のクライアントがポインタを保持しています（グラブステータス %1$s、%2$d 回の試行後）；GNOME 自体がデバイスを保持しているので、そこでシェル拡張メニューを使用してください"

#. From popup/src/lib.rs - keyboard grab held by another client
#, c-format
msgid "another client holds the keyboard (grab status %s after %d attempts); GNOME keeps the devices grabbed for the whole session, use the shell extension menu there"
msgstr "他のクライアントがキーボードを保持しています（グラブステータス %1$s、%2$d 回の試行後）；GNOME はセッション全体でデバイスをグラブしているので、そこでシェル拡張メニューを使用してください"

#. From popup/src/lib.rs - menu window never mapped
msgid "the menu window was never mapped"
msgstr "メニューウィンドウがマップされませんでした"

#. From cli/src/main.rs - window list empty
msgid "no controllable windows"
msgstr "制御可能なウィンドウがありません"

#. From cli/src/main.rs - header for window list table
msgid "ID"
msgstr "ID"

msgid "APP"
msgstr "アプリ"

msgid "SIZE"
msgstr "サイズ"

msgid "POSITION"
msgstr "位置"

msgid "TITLE"
msgstr "タイトル"

#. From cli/src/main.rs - basis labels for geometry output
msgid "frame"
msgstr "フレーム"

msgid "client"
msgstr "クライアント"

#. From cli/src/main.rs - extents labels
msgid "extents"
msgstr "余白"

msgid "left"
msgstr "左"

msgid "top"
msgstr "上"

msgid "right"
msgstr "右"

msgid "bottom"
msgstr "下"

msgid "decorated"
msgstr "装飾あり"

msgid "undecorated"
msgstr "装飾なし"

msgid "selected"
msgstr "選択中"

#. From cli/src/main.rs - resize errors
msgid "resize needs exactly one of --size or --percent"
msgstr "resize には --size または --percent のいずれか一方が必要です"

#. From cli/src/main.rs - move errors
msgid "move needs --anchor or --x/--y"
msgstr "move には --anchor または --x/--y が必要です"

#. From cli/src/main.rs - anchor/position conflicts
msgid "--anchor and --x/--y are mutually exclusive"
msgstr "--anchor と --x/--y は互いに排他的です"

msgid "--x needs --y as well"
msgstr "--x には --y も必要です"

msgid "--y needs --x as well"
msgstr "--y には --x も必要です"

#. From cli/src/main.rs - preset operations
#, c-format
msgid "preset %s already exists in %s; use `sizer preset set` to change it"
msgstr "プリセット %s は %s に既に存在します；変更するには `sizer preset set` を使用してください"

msgid "--position is 1-based and must be at least 1"
msgstr "--position は 1 から始まり、少なくとも 1 である必要があります"

#, c-format
msgid "--position %d is out of range: %s holds %d preset(s)"
msgstr "--position %d は範囲外です：%s には %d 個のプリセットがあります"

msgid "preset label must not be empty"
msgstr "プリセットラベルは空にできません"

#, c-format
msgid "row #%d is a menu separator; %s it makes no sense — remove it instead"
msgstr "行 #%d はメニューセパレータです；%s は意味がありません — 代わりに削除してください"

#. From cli/src/main.rs - report_preset actions
msgid "added"
msgstr "追加"

msgid "updated"
msgstr "更新"

msgid "removed"
msgstr "削除"

msgid "moved"
msgstr "移動"

msgid "copied"
msgstr "コピー"

msgid "separator"
msgstr "セパレータ"

#, c-format
msgid "%s separator in %s"
msgstr "%s の %s セパレータ"

#, c-format
msgid "%s %s (%s) in %s"
msgstr "%s の %s %s（%s）"

#. From cli/src/main.rs - preset list headers
msgid "IDX | GROUP | LABEL | SIZE | ANCHOR | HOTKEY"
msgstr "番号 | グループ | ラベル | サイズ | アンカー | ホットキー"

msgid "<separator>"
msgstr "<セパレータ>"

