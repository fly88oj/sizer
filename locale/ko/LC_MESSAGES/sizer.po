msgid "Sizer"
msgstr "Sizer"

msgid "Choose a window size preset at the pointer"
msgstr "포인터 위치에서 창 크기 프리셋 선택"

msgid "No presets configured"
msgstr "프리셋이 구성되지 않음"

msgid "no active window"
msgstr "활성 창 없음"

#, c-format
msgid "... %d more"
msgstr "... 외 %d개"

msgid "the preset menu has no entries"
msgstr "프리셋 메뉴에 항목이 없습니다"

#, c-format
msgid "cannot open X display: %s"
msgstr "X 디스플레이를 열 수 없습니다: %s"

#, c-format
msgid "another client holds the pointer (grab status %s after %d attempts); GNOME holds the devices itself, use the shell extension menu there"
msgstr "다른 클라이언트가 포인터를 점유하고 있습니다(grab 상태 %1$s, %2$d번 시도 후); GNOME이 장치를 자체 점유하므로 셸 확장 메뉴를 사용하세요"

#, c-format
msgid "another client holds the keyboard (grab status %s after %d attempts); GNOME keeps the devices grabbed for the whole session, use the shell extension menu there"
msgstr "다른 클라이언트가 키보드를 점유하고 있습니다(grab 상태 %1$s, %2$d번 시도 후); GNOME이 세션 전체 동안 장치를 점유하므로 셸 확장 메뉴를 사용하세요"

msgid "the menu window was never mapped"
msgstr "메뉴 창이 매핑되지 않았습니다"

msgid "no controllable windows"
msgstr "제어 가능한 창이 없습니다"

msgid "ID"
msgstr "ID"

msgid "APP"
msgstr "앱"

msgid "SIZE"
msgstr "크기"

msgid "POSITION"
msgstr "위치"

msgid "TITLE"
msgstr "제목"

msgid "frame"
msgstr "테두리"

msgid "client"
msgstr "클라이언트"

msgid "extents"
msgstr "여백"

msgid "left"
msgstr "왼쪽"

msgid "top"
msgstr "위"

msgid "right"
msgstr "오른쪽"

msgid "bottom"
msgstr "아래"

msgid "decorated"
msgstr "장식 있음"

msgid "undecorated"
msgstr "장식 없음"

msgid "selected"
msgstr "선택됨"

msgid "resize needs exactly one of --size or --percent"
msgstr "resize에는 --size 또는 --percent 중 하나가 필요합니다"

msgid "move needs --anchor or --x/--y"
msgstr "move에는 --anchor 또는 --x/--y가 필요합니다"

msgid "--anchor and --x/--y are mutually exclusive"
msgstr "--anchor와 --x/--y는 서로 배타적입니다"

msgid "--x needs --y as well"
msgstr "--x에는 --y도 필요합니다"

msgid "--y needs --x as well"
msgstr "--y에는 --x도 필요합니다"

#, c-format
msgid "preset %s already exists in %s; use `sizer preset set` to change it"
msgstr "프리셋 %s이(가) %s에 이미 존재합니다; 변경하려면 `sizer preset set`을 사용하세요"

msgid "--position is 1-based and must be at least 1"
msgstr "--position은 1부터 시작하며 최소 1이어야 합니다"

#, c-format
msgid "--position %d is out of range: %s holds %d preset(s)"
msgstr "--position %d은(는) 범위를 벗어났습니다: %s에 %d개의 프리셋이 있음"

msgid "preset label must not be empty"
msgstr "프리셋 레이블은 비어 있을 수 없습니다"

#, c-format
msgid "row #%d is a menu separator; %s it makes no sense — remove it instead"
msgstr "행 #%d은(는) 메뉴 구분선입니다; %s은 말이 안 됩니다 — 대신 삭제하세요"

msgid "added"
msgstr "추가됨"

msgid "updated"
msgstr "업데이트됨"

msgid "removed"
msgstr "제거됨"

msgid "moved"
msgstr "이동됨"

msgid "copied"
msgstr "복사됨"

msgid "separator"
msgstr "구분선"

#, c-format
msgid "%s separator in %s"
msgstr "%s의 %s 구분선"

#, c-format
msgid "%s %s (%s) in %s"
msgstr "%s의 %s %s (%s)"

msgid "IDX | GROUP | LABEL | SIZE | ANCHOR | HOTKEY"
msgstr "번호 | 그룹 | 레이블 | 크기 | 앵커 | 단축키"

msgid "<separator>"
msgstr "<구분선>"

#, c-format
msgid "%s copy"
msgstr "%s 복사본"

#, c-format
msgid "%s copy %d"
msgstr "%s 복사본 %d"

#, c-format
msgid "saved %s from window %s as %s in %s"
msgstr "창 %s의 %s 크기를 %s으로 %s에 저장했습니다"

msgid "the top level"
msgstr "최상위"

#, c-format
msgid "group %s"
msgstr "그룹 %s"

msgid "daemon writes plain logs, not JSON; drop --json"
msgstr "daemon은 JSON이 아닌 일반 로그를 기록합니다; --json을 제거하세요"

msgid "no macro given and standard input is empty"
msgstr "매크로가 제공되지 않았고 표준 입력도 비어 있습니다"

msgid "cannot locate a configuration file (use --config, XDG_CONFIG_HOME or HOME)"
msgstr "설정 파일을 찾을 수 없습니다(--config, XDG_CONFIG_HOME 또는 HOME 사용)"

#, c-format
msgid "%s (missing; built-in presets apply)"
msgstr "%s (없음; 내장 프리셋 적용)"

msgid "configuration is invalid"
msgstr "설정이 유효하지 않습니다"

#, c-format
msgid "%s (invalid: %s; run `sizer config check`)"
msgstr "%s (유효하지 않음: %s; `sizer config check` 실행)"

#, c-format
msgid "%s (%d preset%s)"
msgstr "%s (%d개의 프리셋%s)"

msgid "hotkey %s registered and delivery verified"
msgstr "단축키 %s 등록 및 전달 확인 완료"

#, c-format
msgid "hotkey %s registered but unverified: %s"
msgstr "단축키 %s 등록됨但미확인: %s"

#, c-format
msgid "hotkey %s unavailable: %s"
msgstr "단축키 %s 사용 불가: %s"

#, c-format
msgid "fired %d time(s) in %ds"
msgstr "%d초 동안 %d회 발동"

msgid "gnome extension not on the session bus (install it, log out and back in, then `gnome-extensions enable sizer@sizerlinux.dev`)"
msgstr "GNOME 확장이 세션 버스에 없습니다(설치 후 로그아웃했다 다시 로그인한 다음 `gnome-extensions enable sizer@sizerlinux.dev` 실행)"

#, c-format
msgid "gnome extension running (%d presets, menu %s)"
msgstr "GNOME 확장 실행 중 (%d개의 프리셋, 메뉴 %s)"

msgid "open"
msgstr "열림"

msgid "closed"
msgstr "닫힘"

msgid "session"
msgstr "세션"

msgid "config"
msgstr "설정"

msgid "shell"
msgstr "셸"

msgid "backend"
msgstr "백엔드"

msgid "caps"
msgstr "기능"

msgid "monitors"
msgstr "모니터"

#, c-format
msgid "session %s"
msgstr "세션 %s"

#, c-format
msgid "config %s"
msgstr "설정 %s"

#, c-format
msgid "shell %s"
msgstr "셸 %s"

#, c-format
msgid "backend %s (%s)"
msgstr "백엔드 %s (%s)"

#, c-format
msgid "monitors %d"
msgstr "모니터 %d"

#, c-format
msgid "  [%d] %s"
msgstr "  [%d] %s"

#, c-format
msgid "workarea %dx%d at %d,%d"
msgstr "작업 영역 %dx%d at %d,%d"

msgid "active"
msgstr "활성"

msgid "active   none"
msgstr "활성 없음"

#, c-format
msgid "active   %s"
msgstr "활성 %s"

#, c-format
msgid "window %s above = %s"
msgstr "창 %s 위쪽 = %s"

#, c-format
msgid "window %s maximized = %s"
msgstr "창 %s 최대화 = %s"

#, c-format
msgid "no configuration file at %s; using built-in presets"
msgstr "%s에 설정 파일 없음; 내장 프리셋 사용"

#, c-format
msgid "watching %s"
msgstr "%s 감시 중"

#, c-format
msgid "%s disappeared; using built-in presets"
msgstr "%s 사라짐; 내장 프리셋 사용"

#, c-format
msgid "configuration changed; pushing new presets"
msgstr "설정 변경됨; 새 프리셋 푸시 중"

#, c-format
msgid "%s: %s; keeping the last good presets"
msgstr "%s: %s; 마지막 유효 프리셋 유지"

msgid "shell extension is back"
msgstr "셸 확장 복구됨"

#, c-format
msgid "pushed %d of %d presets from %s"
msgstr "%1$d/%2$d개 프리셋을 %3$s에서 푸시 완료"

msgid "built-in presets"
msgstr "내장 프리셋"

#, c-format
msgid "the shell extension rejected the preset list (%s); its menu keeps the previous presets"
msgstr "셸 확장이 프리셋 목록(%s)을 거부함; 메뉴가 이전 프리셋 유지"

#, c-format
msgid "cannot read the SetPresets reply (%s): %s"
msgstr "SetPresets 응답을 읽을 수 없음(%s): %s"

#, c-format
msgid "SetPresets failed: %s"
msgstr "SetPresets 실패: %s"

#, c-format
msgid "waiting for the GNOME shell extension (%s): %s"
msgstr "GNOME 셸 확장 대기 중(%s): %s"

#, c-format
msgid "the shell extension skipped %s: %s"
msgstr "셸 확장이 %s 건너뜀: %s"

msgid "<unnamed>"
msgstr "<이름 없음>"

msgid "invalid preset"
msgstr "유효하지 않은 프리셋"

#, c-format
msgid "options.hotkey: %s; the GNOME extension keeps its current keybinding"
msgstr "options.hotkey: %s; GNOME 확장이 현재 키 바인딩 유지"

#, c-format
msgid "cannot connect to the session bus: %s"
msgstr "세션 버스에 연결할 수 없음: %s"

#, c-format
msgid "unsupported version %d, expected %d"
msgstr "지원되지 않는 버전 %d, 예상 %d"

msgid "a separator must not carry a label, size, anchor, position, hotkey or monitor"
msgstr "구분선에는 레이블, 크기, 앵커, 위치, 단축키 또는 모니터가 없어야 합니다"

msgid "label must not be empty"
msgstr "레이블은 비어 있을 수 없습니다"

#, c-format
msgid "duplicate label %s in the same group"
msgstr "동일한 그룹에 중복 레이블 %s 있음"

msgid "hotkey must not be empty"
msgstr "단축키는 비어 있을 수 없습니다"

msgid "x and y must be set together"
msgstr "x와 y는 함께 설정해야 합니다"

msgid "anchor and x/y are mutually exclusive"
msgstr "anchor와 x/y는 서로 배타적입니다"

msgid "not an object"
msgstr "객체가 아님"

msgid "size must look like 1024x768 or 50%x50%"
msgstr "크기는 1024x768 또는 50%x50% 형식이어야 합니다"

#, c-format
msgid "unknown anchor %s"
msgstr "알 수 없는 앵커 %s"

msgid "x and y must be integers set together"
msgstr "x와 y는 정수여야 하며 함께 설정해야 합니다"

#, c-format
msgid "unknown monitor %s"
msgstr "알 수 없는 모니터 %s"

msgid "no_target_window"
msgstr "대상 창 없음"

msgid "no_such_monitor"
msgstr "해당 모니터 없음"

msgid "no_work_area"
msgstr "작업 영역 없음"

msgid "no_presets"
msgstr "프리셋 없음"

msgid "menu_closed"
msgstr "메뉴 닫힘"

msgid "no_such_row"
msgstr "해당 행 없음"

msgid "window destroyed"
msgstr "창 파괴됨"

msgid "superseded"
msgstr "대체됨"

msgid "unmaximize_timeout"
msgstr "최대화 해제 시간 초과"
