msgid "no_target_window"
msgstr "无目标窗口"

msgid "no_such_monitor"
msgstr "无此显示器"

msgid "no_work_area"
msgstr "无工作区"

msgid "no_presets"
msgstr "无预设"

msgid "menu_closed"
msgstr "菜单已关闭"

msgid "no_such_row"
msgstr "无此行"

msgid "window destroyed"
msgstr "窗口已销毁"

msgid "superseded"
msgstr "已被取代"

msgid "unmaximize_timeout"
msgstr "取消最大化超时"
