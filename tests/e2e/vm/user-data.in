#cloud-config
# Template for the Ubuntu 26.04 desktop VM. Everything host-specific is substituted
# by start-vm.sh (the SSH key is generated per run and never stored in the repo), so
# this file carries no credentials.
hostname: __HOSTNAME__
manage_etc_hosts: true
users:
  - name: __USER__
    groups: [sudo, adm, audio, video, render]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - __SSH_KEY__
ssh_pwauth: false
package_update: true
packages:
  - ubuntu-desktop-minimal
  - python3-gi
  - python3-gi-cairo
  - gir1.2-gtk-4.0
  - dbus-x11
  - xdg-desktop-portal-gnome
write_files:
  - path: /etc/gdm3/custom.conf
    permissions: '0644'
    content: |
      [daemon]
      AutomaticLoginEnable=true
      AutomaticLogin=__USER__
      WaylandEnable=true
runcmd:
  - systemctl set-default graphical.target
  # Without this marker the first login opens the setup wizard, whose window takes
  # the focus the preset assertions need.
  - bash -c 'install -d -o __USER__ -g __USER__ /home/__USER__/.config && touch /home/__USER__/.config/gnome-initial-setup-done && chown __USER__:__USER__ /home/__USER__/.config/gnome-initial-setup-done'
  - systemctl start gdm3 || true
